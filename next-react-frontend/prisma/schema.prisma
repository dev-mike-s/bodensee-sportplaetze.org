
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Locality {
  id              Int        @id @default(autoincrement())
  name            String     @unique @db.VarChar(30)
  zipcode         Int
  localityType    LocalityType?
  addresses       Address[]
}

model Address {
  id            Int          @id @default(autoincrement())
  name          String?      @db.VarChar(30)
  street        String?      @db.VarChar(30)
  localityId    Int
  locality      Locality     @relation(fields: [localityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sportFields   SportField[]
}

model SportField {
  id                Int                 @id @default(autoincrement())
  addressId         Int?
  name              String?             @db.VarChar(30)
  floor             String?             @db.VarChar(20)
  description       String?             @db.VarChar(50)
  rating            Int
  
  address           Address?            @relation(fields: [addressId], references: [id])
  sportFieldType    SportFieldType[]
}

model SportFieldType {
  sportFieldId  Int
  sportTypeId   Int
  sportFields   SportField  @relation(fields: [sportFieldId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sportType     SportType   @relation(fields: [sportTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([sportFieldId, sportTypeId])
}

model SportType {
  id              Int                    @id @default(autoincrement())
  name            String?                @db.VarChar(30)
  sportFieldType  SportFieldType[]
}

enum LocalityType {
  CITY
  DISTRICT
  MUNICIPALITY
}
