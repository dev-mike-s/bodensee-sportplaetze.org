!**/.env.template
!**/.env.sample

# Logs and temporary files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*.tmp

# TypeScript generated files
**/*.tsbuildinfo
**/next-env.d.ts

# IDE and operating system files
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
*.pem
.vs/
